<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>EvenMoreBalancedMortician</AssemblyName>
        <RootNamespace>EvenMoreBalancedMortician</RootNamespace>
        <ThunderstorePackageName>Even_More_Balanced_Mortician</ThunderstorePackageName>
        <Author>Delfofthebla</Author>
        <Version>1.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.3" PrivateAssets="all"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Morris" HintPath="$(ProfilePluginsDir)\Bog-Mortician\Morris.dll" Publicize="true"/>
        <Reference Include="R2API.Deployable" HintPath="$(ProfilePluginsDir)\RiskofThunder-R2API_Deployable\R2API.Deployable\R2API.Deployable.dll"/>
        <Reference Include="R2API.Language" HintPath="$(ProfilePluginsDir)\RiskofThunder-R2API_Language\R2API.Language\R2API.Language.dll"/>
    </ItemGroup>
</Project>
